{
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "pnpm build",
      "installCommand": "pnpm install",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/((?!assets|favicon\\.png).*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
