{
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "pnpm build",
      "installCommand": "pnpm install",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/storage/(.*)",
      "destination": "https://laravel-backend-production-7438ec96.up.railway.app/storage/$1"
    },
    {
      "source": "/((?!assets|favicon\\.png).*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
